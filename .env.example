# Postgres (Neon). Leave unset locally to use the embedded PGlite database in ./data/pglite.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Shown on the public site when set.
NEXT_PUBLIC_BRAND_PHONE=
NEXT_PUBLIC_BRAND_EMAIL=
# Time zone used for "today / this week / this month" stats.
APP_TZ=America/New_York
# Dialerr panel in the owner admin (embed keys from Dialerr → Settings → API Access → Embed).
# Without them the panel still works; you sign in inside it.
NEXT_PUBLIC_DIALERR_KEY=
DIALERR_SECRET=
# Optional: which Dialerr agent the owner panel signs in as (defaults to the key's default agent).
DIALERR_AGENT_EMAIL=
