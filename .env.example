# Postgres (Neon). Leave unset locally to use the embedded PGlite database in ./data/pglite.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Shown on the public site when set.
NEXT_PUBLIC_BRAND_PHONE=
NEXT_PUBLIC_BRAND_EMAIL=
# Time zone used for "today / this week / this month" stats.
APP_TZ=America/New_York
